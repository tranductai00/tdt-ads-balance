{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "rewrites": [
    {
      "source": "/outlookBridge",
      "destination": "/api/outlookBridge"
    },
    {
      "source": "/outlookOAuthCallback",
      "destination": "/api/outlookOAuthCallback"
    },
    {
      "source": "/outlookWebhook",
      "destination": "/api/outlookWebhook"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/adscheck",
      "destination": "/adscheck/index.html"
    },
    {
      "source": "/sodu",
      "destination": "/sodu/index.html"
    }
  ],
  "crons": [
    {
      "path": "/cron/outlook-renew",
      "schedule": "15 20 * * *"
    }
  ],
  "functions": {
    "api/outlookBridge.js": {
      "maxDuration": 300
    },
    "api/outlookOAuthCallback.js": {
      "maxDuration": 300
    },
    "api/outlookWebhook.js": {
      "maxDuration": 300
    }
  }
}
