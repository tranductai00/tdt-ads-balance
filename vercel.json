{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "rewrites": [
    {
      "source": "/metaBridge",
      "destination": "/api/metaBridge"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/meta",
      "destination": "/index.html"
    },
    {
      "source": "/sodu",
      "destination": "/sodu/index.html"
    }
  ],
  "functions": {
    "api/metaBridge.js": {
      "maxDuration": 300
    }
  }
}
